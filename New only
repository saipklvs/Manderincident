## 8. CLI TERMINAL COMPONENT (terminal.js — critical fix)

### Fixed Implementation
class Terminal {
  constructor(container) {
    this.container = container
    this.build()
  }

  build() {
    // Create terminal DOM structure
    // Black background, green monospace font
    // Header: "● AWT Investigation Terminal" + 3 dots
    // Output area (scrollable div)
    // Footer div
  }

  run(command, lines, highlightPattern = null) {
    return new Promise((resolve) => {
      this.clear()
      this.typeCommand(command, () => {
        this.showSpinner(() => {
          this.streamLines(lines, highlightPattern, () => {
            this.showFooter(lines.length)
            resolve()
          })
        })
      })
    })
  }

  typeCommand(command, callback) {
    // Use setTimeout chain — one char at a time — 50ms per char
    let i = 0
    const type = () => {
      if (i < command.length) {
        this.appendChar(command[i])
        i++
        setTimeout(type, 50)
      } else {
        callback()
      }
    }
    type()
  }

  showSpinner(callback) {
    // Show CSS spinner element
    // setTimeout 1500ms then hide spinner and callback
    setTimeout(() => {
      this.hideSpinner()
      callback()
    }, 1500)
  }

  streamLines(lines, highlightPattern, callback) {
    // Stream lines one at a time with setTimeout chain
    let i = 0
    const addLine = () => {
      if (i < lines.length) {
        const isMatch = highlightPattern &&
          lines[i].includes(highlightPattern)
        this.appendLine(lines[i], isMatch)
        this.scrollToBottom()
        i++
        setTimeout(addLine, 80)
      } else {
        callback()
      }
    }
    addLine()
  }
}

